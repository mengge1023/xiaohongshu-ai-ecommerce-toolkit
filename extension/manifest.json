{
  "manifest_version": 3,
  "name": "小红书爆款采集插件（生财专属版）",
  "version": "0.3.5.1",
  "description": "生财专属版：点击小红书单篇笔记的分享按钮，将笔记、图片和互动数据保存到自己的飞书表格。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*",
    "https://*.feishu.cn/*",
    "https://base-api.feishu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.xiaohongshu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.feishu.cn/wiki/*"
      ],
      "js": [
        "feishu-link.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "打开生财专属采集插件设置"
  },
  "options_page": "options.html",
  "key": "",
  "minimum_chrome_version": "116",
  "version_name": "0.3.5 生财专属版 1"
}
